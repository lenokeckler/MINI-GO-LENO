{
  "version": 3,
  "configurePresets": [
    {
      "name": "ucrt64-release",
      "displayName": "MSYS2 UCRT64 — Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":    "Release",
        "CMAKE_C_COMPILER":   "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
        "ANTLR4_JAR":         "${sourceDir}/antlr-4.13.2-complete.jar"
      }
    },
    {
      "name": "ucrt64-debug",
      "displayName": "MSYS2 UCRT64 — Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":    "Debug",
        "CMAKE_C_COMPILER":   "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
        "ANTLR4_JAR":         "${sourceDir}/antlr-4.13.2-complete.jar"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "ucrt64-release"
    },
    {
      "name": "debug",
      "configurePreset": "ucrt64-debug"
    }
  ]
}
